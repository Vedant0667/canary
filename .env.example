# Optional. If set, View ① calls the Anthropic API live to extract the packet.
# If unset OR the call errors/times out (>6s), the app silently uses the
# committed cached extraction in src/data/extractions/ — indistinguishable on stage.
# Press `F` in the app to force fallback (offline) mode at any time.
VITE_ANTHROPIC_API_KEY=
